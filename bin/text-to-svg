#!/usr/bin/env node

/**
 * Copyright (c) 2016 Hideki Shiro
 */

const package = require('../package');
const path = require('path');

const { Command } = require('commander');
const program = new Command();

program
  .version(package.version)
  .usage('[options] text')
  .option('-x, --x <n>', 'horizontal offset', parseFloat)
  .option('-y, --y <n>', 'vertical offset', parseFloat)
  .option('-s, --font-size <n>', 'font size', parseFloat)
  .option('-f, --font [value]', 'font')
  .option('-c, --color [value]', 'color')
  .option('-k, --kerning', 'kerning')
  .option('-a, --anchor [value]', 'anchor point')
  .option('-d, --debug', 'debug')
  .option('--arc-angle <n>', 'arc transformation angle in degrees (positive for upward, negative for downward)', parseFloat)
  .option('--arc-center-x <n>', 'arc center X coordinate', parseFloat)
  .option('--arc-center-y <n>', 'arc center Y coordinate', parseFloat)
  .parse(process.argv);

if(program.args.length < 1) {
  program.outputHelp();
  process.exit();
}

const opts = program.opts();
const text = program.args[0];
let attributes = {};
if (opts.color) {
  attributes = {
    fill: opts.color
  }
}
const options = {
  x: opts.x || 0,
  y: opts.y || 0,
  fontSize: opts.fontsize || 72,
  kerning: opts.kerning,
  anchor: opts.anchor || '',
  attributes: attributes
};

// Add envelope transformation if arc options are provided
if (opts.arcAngle !== undefined) {
  options.envelope = {
    arc: {
      angle: opts.arcAngle
    }
  };
  
  // Add custom center coordinates if provided
  if (opts.arcCenterX !== undefined) {
    options.envelope.arc.centerX = opts.arcCenterX;
  }
  if (opts.arcCenterY !== undefined) {
    options.envelope.arc.centerY = opts.arcCenterY;
  }
}

const fontsPath = path.join(__dirname, '..', 'fonts');
let font;
if (!program.opts().font) {
  font = path.join(fontsPath, 'SourceHanSerifJP-Light.otf')
} else {
  font = program.opts().font
}

const TextToSVG = require('../build');
const textToSVG = TextToSVG.default ? TextToSVG.default.loadSync(font) : TextToSVG.loadSync(font);

let svg;
if (!opts.debug) {
  svg = textToSVG.getSVG(text, options);
} else {
  svg = textToSVG.getDebugSVG(text, options);
}

console.log(svg);
