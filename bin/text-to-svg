#!/usr/bin/env node

/**
 * Copyright (c) 2016 Hideki Shiro
 */

const package = require('../package');
const path = require('path');

const { Command } = require('commander');
const program = new Command();

program
  .version(package.version)
  .usage('[options] text')
  .option('-x, --x <n>', 'horizontal offset', parseFloat)
  .option('-y, --y <n>', 'vertical offset', parseFloat)
  .option('-s, --font-size <n>', 'font size', parseFloat)
  .option('-f, --font [value]', 'font')
  .option('-c, --color [value]', 'color')
  .option('-k, --kerning', 'kerning')
  .option('-a, --anchor [value]', 'anchor point')
  .option('-d, --debug', 'debug')
  .option('--line-height <n>', 'line height multiplier for multiline text', parseFloat)
  .option('--text-align [value]', 'text alignment for multiline text (left, center, right)')
  .option('--writing-mode [value]', 'writing mode: horizontal (default) or vertical')
  .option('--arc-angle <n>', 'arc transformation angle in degrees (positive for upward, negative for downward)', parseFloat)
  .option('--arc-center-x <n>', 'arc center X coordinate', parseFloat)
  .option('--arc-center-y <n>', 'arc center Y coordinate', parseFloat)
  .parse(process.argv);

if(program.args.length < 1) {
  program.outputHelp();
  process.exit();
}

const opts = program.opts();
// Process escape sequences in text (e.g., \n to actual newlines)
const text = program.args[0].replace(/\\n/g, '\n').replace(/\\t/g, '\t').replace(/\\\\/g, '\\');
let attributes = {};
if (opts.color) {
  attributes = {
    fill: opts.color
  }
}
const options = {
  x: opts.x || 0,
  y: opts.y || 0,
  fontSize: opts.fontSize || 72,
  kerning: opts.kerning,
  anchor: opts.anchor || '',
  attributes: attributes
};

// Add multiline options if provided
if (opts.lineHeight !== undefined) {
  options.lineHeight = opts.lineHeight;
}
if (opts.textAlign !== undefined) {
  options.textAlign = opts.textAlign;
}

// Add writing mode option if provided
if (opts.writingMode !== undefined) {
  if (opts.writingMode === 'vertical' || opts.writingMode === 'horizontal') {
    options.writingMode = opts.writingMode;
    
    // Warn about unsupported options in vertical mode
    if (opts.writingMode === 'vertical' && opts.textAlign !== undefined) {
      console.warn('Warning: Text alignment is not supported in vertical writing mode. --text-align option will be ignored.');
    }
  } else {
    console.error('Error: --writing-mode must be either "horizontal" or "vertical"');
    process.exit(1);
  }
}

// Add envelope transformation if arc options are provided
if (opts.arcAngle !== undefined) {
  if (options.writingMode === 'vertical') {
    console.warn('Warning: Envelope transformations are not supported in vertical writing mode. Arc options will be ignored.');
  } else {
    options.envelope = {
      arc: {
        angle: opts.arcAngle
      }
    };
    
    // Add custom center coordinates if provided
    if (opts.arcCenterX !== undefined) {
      options.envelope.arc.centerX = opts.arcCenterX;
    }
    if (opts.arcCenterY !== undefined) {
      options.envelope.arc.centerY = opts.arcCenterY;
    }
  }
}

const fontsPath = path.join(__dirname, '..', 'fonts');
let font;
if (!program.opts().font) {
  font = path.join(fontsPath, 'SourceHanSerifJP-Light.otf')
} else {
  font = program.opts().font
}

const TextToSVG = require('../build');
const textToSVG = TextToSVG.default ? TextToSVG.default.loadSync(font) : TextToSVG.loadSync(font);

let svg;
if (!opts.debug) {
  svg = textToSVG.getSVG(text, options);
} else {
  svg = textToSVG.getDebugSVG(text, options);
}

console.log(svg);
